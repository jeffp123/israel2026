---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const sorted = [...entries].sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
  return entries.map((entry) => {
    const i = sorted.findIndex((e) => e.id === entry.id);
    return {
      params: { slug: entry.id },
      props: { entry, prev: sorted[i - 1] ?? null, next: sorted[i + 1] ?? null },
    };
  });
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const h2s = headings.filter((h) => h.depth === 2);
---
<EntryLayout data={entry.data} headings={h2s} prev={prev} next={next}>
  <Content />
</EntryLayout>
