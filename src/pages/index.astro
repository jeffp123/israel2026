---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import '../styles/global.css';
import '@fontsource-variable/fraunces';
import '@fontsource/ibm-plex-sans/400.css';

const allEntries = await getCollection('entries');
allEntries.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Travelogue</title>
  </head>
  <body>
    <main class="prose">
      <header class="hero">
        <div class="hero-caption">
          <h1 class="entry-title">Travelogue</h1>
        </div>
      </header>

      <ol class="entry-list">
        {allEntries.map((entry) => (
          <li>
            <a href={import.meta.env.BASE_URL.replace(/\/$/, '') + '/entries/' + entry.id}>
              {entry.data.cover && <Image src={entry.data.cover} alt="" />}
              <h2>{entry.data.title}</h2>
              <time datetime={entry.data.date.toISOString()}>
                {entry.data.date.toLocaleDateString('en-US', {
                  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
                })}
              </time>
              {entry.data.dek && <p>{entry.data.dek}</p>}
            </a>
          </li>
        ))}
      </ol>
    </main>
  </body>
</html>
