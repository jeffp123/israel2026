---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import "../styles/global.css";
import "@fontsource-variable/fraunces";
import "@fontsource/ibm-plex-sans/400.css";
import masthead from "../assets/2026-08-20/213733-laser-light-show-over-jerusalem/215405.jpg";

const allEntries = await getCollection("entries");
allEntries.sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const firstEntry = allEntries[0];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Peck Family in Israel 2026</title>
  </head>
  <body>
    <main class="prose">
      <header class="hero">
        <Image src={masthead} alt="" />
        <div class="hero-caption">
          <p class="kicker">Travelogue</p>
          <h1 class="entry-title">Peck Family in Israel 2026</h1>
        </div>
      </header>

      <p class="intro">
        This is our Israel 2026 Blog that I Chaim Peck, am reconstructing from
        photos, notes, and memories throughout our trip. I will be updating this
        periodically with a new entry, memory, or set of pictures, all dated
        according to the day that they happened. You can check back here for
        updates.
      </p>

      {
        firstEntry && (
          <p class="start-link">
            <a href={`${base}/entries/${firstEntry.id}`}>
              Start from the beginning →
            </a>
          </p>
        )
      }

      <ol class="entry-list">
        {
          allEntries.map((entry) => (
            <li>
              <a href={`${base}/entries/${entry.id}`}>
                {entry.data.cover && <Image src={entry.data.cover} alt="" />}
                <h2>{entry.data.title}</h2>
                <time datetime={entry.data.date.toISOString()}>
                  {entry.data.date.toLocaleDateString("en-US", {
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                    timeZone: "UTC",
                  })}
                </time>
                {entry.data.dek && <p>{entry.data.dek}</p>}
              </a>
            </li>
          ))
        }
      </ol>
    </main>
  </body>
</html>
