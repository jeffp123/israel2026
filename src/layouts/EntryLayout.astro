---
import '../styles/global.css';
import '@fontsource-variable/fraunces';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import 'photoswipe/style.css';
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';

import { Image } from 'astro:assets';
import Toc from '../components/Toc.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  data: {
    title: string;
    date: Date;
    location?: string;
    dek?: string;
    cover?: ImageMetadata;
  };
  headings: { depth: number; slug: string; text: string }[];
}

const { data, headings } = Astro.props;

const dateStr = data.date.toLocaleDateString('en-US', {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const kicker = [data.location, dateStr].filter(Boolean).join(' · ');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{data.title}</title>
  </head>
  <body>
    <main class="prose">
      <header class="hero">
        {data.cover && <Image src={data.cover} alt="" />}
        <div class="hero-caption">
          {kicker && <p class="kicker">{kicker}</p>}
          <h1 class="entry-title">{data.title}</h1>
          {data.dek && <p class="dek">{data.dek}</p>}
        </div>
      </header>

      {headings.length > 0 && (
        <>
          <details class="toc-mobile">
            <summary>On this page</summary>
            <Toc headings={headings} />
          </details>
          <aside class="toc-rail">
            <Toc headings={headings} />
          </aside>
        </>
      )}

      <slot />

      <footer>
        <p>© {new Date().getFullYear()}</p>
      </footer>
    </main>

    <script>
      import PhotoSwipeLightbox from 'photoswipe/lightbox';
      document.querySelectorAll('.gallery').forEach((g, i) => {
        if (!g.id) g.id = 'gallery-' + i;
        new PhotoSwipeLightbox({
          gallery: '#' + g.id, children: 'a',
          pswpModule: () => import('photoswipe'),
        }).init();
      });

      import Swiper from 'swiper';
      import { Navigation, Pagination, Keyboard, A11y } from 'swiper/modules';
      document.querySelectorAll('.carousel').forEach((el) => {
        new Swiper(el as HTMLElement, {
          modules: [Navigation, Pagination, Keyboard, A11y],
          slidesPerView: 1, spaceBetween: 8, keyboard: { enabled: true },
          navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' },
          pagination: { el: '.swiper-pagination', clickable: true },
          breakpoints: { 768: { slidesPerView: 1.15 } },
        });
      });

      const links = new Map(
        [...document.querySelectorAll('.toc a')].map((a) => [a.getAttribute('href')!.slice(1), a])
      );
      const spy = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) {
          document.querySelectorAll('.toc a.is-current').forEach((a) => a.classList.remove('is-current'));
          links.get((e.target as HTMLElement).id)?.classList.add('is-current');
        }
      }, { rootMargin: '0px 0px -70% 0px' });
      document.querySelectorAll('main h2[id]').forEach((h) => spy.observe(h));
    </script>
  </body>
</html>
